# Example Nginx config for akadako-py-web (static + cross-origin isolation).
# Point `root` at the repository root (after running ./fetch-vendor.sh).

server {
    listen 443 ssl http2;
    server_name akadako-py.example.com;     # use an HTTPS host

    # ssl_certificate / ssl_certificate_key ...

    root /var/www/akadako-py-web;
    index web/index.html;

    # Correct MIME for Pyodide's wasm (needed for streaming compile).
    types {
        application/wasm   wasm;
        application/zip    zip;
        text/javascript    js;
        text/css           css;
        text/html          html;
    }

    # Cross-origin isolation on EVERY response (enables SharedArrayBuffer).
    add_header Cross-Origin-Opener-Policy   "same-origin"  always;
    add_header Cross-Origin-Embedder-Policy "require-corp" always;

    location / {
        try_files $uri $uri/ =404;
    }

    # Immutable runtime -> long cache. add_header must be repeated because a
    # location block replaces inherited headers.
    location /web/vendor/ {
        add_header Cross-Origin-Opener-Policy   "same-origin"  always;
        add_header Cross-Origin-Embedder-Policy "require-corp" always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }
}
